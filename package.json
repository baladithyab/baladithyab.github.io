{
  "name": "codeseys.io",
  "version": "24.11.28",
  "description": "Personal portfolio and blog built with Astro.",
  "author": {
    "name": "baladithyab"
  },
  "license": "MIT",
  "scripts": {
    "clean": "bun exec \"rm -rf node_modules\"",
    "sync:projects": "bun run src/scripts/sync-project-manifests.ts",
    "build": "bun run sync:projects && astro build",
    "dev": "astro dev",
    "format": "prettier -w . --cache",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "deploy.dryrun": "wrangler deploy --dry-run",
    "wrangler.types": "wrangler types",
    "r2:bootstrap": "bash scripts/r2-bootstrap.sh",
    "start": "astro dev",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/react": "^5.0.7",
    "@astrojs/ts-plugin": "^1.10.12",
    "@cf-wasm/og": "^0.3.8",
    "@nanostores/persistent": "^1.3.5",
    "@panzoom/panzoom": "^4.6.2",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "astro": "^6.4.8",
    "astro-navbar": "^2.4.0",
    "baseline-browser-mapping": "^2.11.35",
    "caniuse-lite": "^1.0.30001822",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.69.0",
    "nanostores": "^1.5.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@iconify/json": "^2.2.553",
    "@tailwindcss/vite": "^4.3.4",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "marked": "^18.1.3",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rehype-mermaid": "^3.0.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.2.0",
    "unplugin-icons": "^23.0.1",
    "vitest": "^4.1.12",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "vite": "^7.3.7"
  }
