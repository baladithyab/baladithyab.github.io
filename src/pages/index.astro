---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { buttonVariants } from '@/components/ui/button'
import { Card, CardHeader, CardTitle, CardContent } from '@/components/ui/card'
import { Badge } from '@/components/ui/badge'
import ExperienceProjectsTabs from '@/components/ExperienceProjectsTabs'
import GrommetIconsGithub from '~icons/grommet-icons/github'
import GrommetIconsLinkedin from '~icons/grommet-icons/linkedin'
import GrommetIconsMail from '~icons/grommet-icons/mail'
import SimpleIconsGooglescholar from '~icons/simple-icons/googlescholar'
import profile from '@/lib/profile.json'

const { skills, experiences } = profile

const projects = [
  {
    title: 'Second Brain Personal Assistant',
    bullets: [
      'Built a containerized, self-hosted server infrastructure capable of capturing, retrieving, and storing knowledge in real-time.',
      'Integrated GPT-4o to augment and dynamically organize data from web browsing sessions and received content.',
      'Features a responsive UI for seamless interaction with your knowledge base.',
    ],
    link: '/blog/second-brain-assistant',
  },
  {
    title: 'Video Hosting & AV1 Transcoding Pipeline',
    bullets: [
      'Constructed an automated AWS-based pipeline for efficient video ingestion, transcoding to AV1 format, and content delivery.',
      'Created an intuitive, web-based interface enabling seamless user interaction and video streaming with adaptive bitrate capabilities.',
    ],
    link: '/blog',
  },
  {
    title: 'Algorithmic Trading Evaluation Platform',
    bullets: [
      'Designed a scalable system for evaluating and optimizing stock trading algorithms.',
      'Leveraged LLMs to write financial models for backtesting and identify optimal trading strategies in a genetic algorithm format.',
    ],
    link: '/blog',
  },
  {
    title: 'OS-Agnostic Audio Capture & Conference AI Assistant',
    bullets: [
      'Developed a platform-independent audio capturing solution for real-time transcription and diarization across various conferencing applications.',
      'Integrated machine learning pipelines to enable live speaker diarization and accurate transcription.',
    ],
    link: '/blog',
  },
]
---

<BaseLayout
  title={`${profile.name} | ${profile.currentRole}`}
  description={profile.summary}
  ogTag="Home"
  ogAccent="#a78bfa"
>
  <section class="container mx-auto max-w-5xl px-6 py-16">
    <div class="mb-12 text-center">
      <h1
        class="gradient-text mb-4 p-1 text-4xl leading-tight font-extrabold tracking-tighter md:text-5xl"
      >
        Baladithya Balamurugan
      </h1>
      <p class="text-muted-foreground mb-6 text-xl">
        {profile.headline}
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href={profile.links.email}
          class={buttonVariants({ variant: 'outline' })}
        >
          <GrommetIconsMail class="mr-2 h-4 w-4" /> Email
        </a>
        <a
          href={profile.links.linkedin}
          target="_blank"
          rel="noreferrer"
          class={buttonVariants({ variant: 'outline' })}
        >
          <GrommetIconsLinkedin class="mr-2 h-4 w-4" /> LinkedIn
        </a>
        <a
          href={profile.links.github}
          target="_blank"
          rel="noreferrer"
          class={buttonVariants({ variant: 'outline' })}
        >
          <GrommetIconsGithub class="mr-2 h-4 w-4" /> GitHub
        </a>
        <a
          href={profile.links.scholar}
          target="_blank"
          rel="noopener noreferrer"
          class={buttonVariants({ variant: 'outline' })}
        >
          <SimpleIconsGooglescholar class="mr-2 h-4 w-4" /> Google Scholar
        </a>
      </div>
    </div>

    <div class="mb-10 grid gap-8 md:grid-cols-2">
      <Card className="hover-card bg-card/50 self-start">
        <CardHeader>
          <CardTitle>About Me</CardTitle>
        </CardHeader>
        <CardContent>
          <p class="leading-relaxed">{profile.summary}</p>
          <details id="about-details" class="group mt-4">
            <summary
              class="text-primary min-h-11 cursor-pointer rounded-sm py-2 text-sm font-medium underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4"
            >
              <span class="group-open:hidden">Show more</span>
              <span class="hidden group-open:inline">Show less</span>
              <span class="sr-only"> about me</span>
            </summary>
            <div class="space-y-4 pt-4">
              {
                profile.about.map((paragraph) => (
                  <p class="leading-relaxed">{paragraph}</p>
                ))
              }
            </div>
          </details>
        </CardContent>
      </Card>

      <div class="flex flex-col gap-8">
        <Card className="hover-card bg-card/50">
          <CardHeader>
            <CardTitle>Education</CardTitle>
          </CardHeader>
          <CardContent>
            {
              profile.education.map((education) => (
                <div class="mb-4 last:mb-0">
                  <h3 class="text-lg font-semibold">{education.degree}</h3>
                  <p class="text-muted-foreground text-sm">
                    {education.school} | {education.date}
                  </p>
                </div>
              ))
            }
          </CardContent>
        </Card>

        <Card className="hover-card bg-card/50">
          <CardHeader>
            <CardTitle>Skills</CardTitle>
          </CardHeader>
          <CardContent>
            <div class="flex flex-wrap gap-2">
              {
                skills.map((skill) => (
                  <Badge variant="secondary" className="skill-badge">
                    {skill}
                  </Badge>
                ))
              }
            </div>
          </CardContent>
        </Card>
      </div>
    </div>

    <ExperienceProjectsTabs
      client:visible={{ rootMargin: '200px' }}
      experiences={experiences}
      projects={projects}
    />
  </section>
</BaseLayout>
