---
import BaseLayout from '@/layouts/BaseLayout.astro'

// Unlisted: nothing on the site links here, and `noindex` keeps the page out
// of search results. It is reachable only by its URL.

// Must match METERS in src/scripts/energy-ring.ts.
const meters = ['bass', 'mid', 'treble', 'beat']
---

<BaseLayout
  title="Energy Ring | Rust + WebAssembly lab"
  description="An audio-reactive energy ring analysed and rendered by Rust compiled to WebAssembly."
  ogTag="Lab"
  ogAccent="#22d3ee"
  noindex
>
  <section class="container mx-auto max-w-3xl px-4 py-8">
    <p class="text-muted-foreground text-sm">Lab · Rust + WebAssembly</p>
    <h1 class="mb-2 text-3xl font-bold">Energy ring</h1>
    <p class="text-muted-foreground">
      A Rust crate compiled to WebAssembly reads the spectrum of whatever this
      page plays and draws a tilted ring with WebGL2. Louder bands lift the ring
      out of its plane. Press play on the built-in loop, or load a track of your
      own.
    </p>

    <div
      class="mx-auto mt-6 aspect-square w-full max-w-xl overflow-hidden rounded-xl border bg-black"
    >
      <canvas
        id="energy-ring-canvas"
        class="block h-full w-full"
        role="img"
        aria-label="Tilted glowing ring whose rim rises and falls with the audio"
      ></canvas>
    </div>
    <p
      id="energy-ring-status"
      class="text-muted-foreground mt-2 text-center text-sm"
      role="status"
    >
      Loading WebAssembly…
    </p>

    <!-- The demo loop is an in-memory blob; buffer it before play is pressed. -->
    <audio
      id="energy-ring-audio"
      class="mt-6 w-full"
      controls
      loop
      preload="auto"></audio>
    <label class="mt-3 flex flex-wrap items-center gap-3 text-sm">
      <span class="font-medium">Use your own audio file</span>
      <input
        id="energy-ring-file"
        class="text-muted-foreground"
        type="file"
        accept="audio/*"
      />
    </label>

    <dl class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
      {
        meters.map((name) => (
          <div>
            <dt class="text-muted-foreground text-xs tracking-wide uppercase">
              {name}
            </dt>
            <dd class="bg-muted mt-1 h-2 overflow-hidden rounded-full">
              <div
                id={`energy-ring-${name}`}
                class="bg-primary h-full origin-left"
                style="scale: 0 1"
              />
            </dd>
          </div>
        ))
      }
    </dl>
  </section>
</BaseLayout>

<script>
  import '@/scripts/energy-ring'
</script>
