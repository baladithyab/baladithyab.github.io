---
import LabLayout from '@/layouts/LabLayout.astro'

// Unlisted: nothing on the site links here, and `noindex` keeps the page out
// of search results. It is reachable only by its URL.

// Must match METERS in src/scripts/energy-ring.ts.
const meters = ['bass', 'mid', 'treble', 'beat']
---

<LabLayout
  title="Energy Ring | Rust + WebAssembly lab"
  description="An audio-reactive energy ring analysed and rendered by Rust compiled to WebAssembly."
  ogTag="Lab"
  ogAccent="#22d3ee"
  appName="Energy Ring"
  appCategory="Rust + WebGL2"
  appSubtitle="Audio-reactive spectrum visualizer"
  darkChrome
  noindex
>
  <button
    slot="topbar-actions"
    id="energy-ring-about-btn"
    type="button"
    class="rounded-md border border-white/15 bg-white/5 px-2.5 py-1 text-xs font-medium text-white/80 transition-colors hover:bg-white/12 hover:text-white"
  >
    About
  </button>

  <section
    class="relative flex min-h-0 flex-1 flex-col overflow-hidden bg-black text-white"
    style="color-scheme: dark"
  >
    <canvas
      id="energy-ring-canvas"
      class="block h-full w-full flex-1"
      role="img"
      aria-label="Tilted glowing ring whose rim rises and falls with the audio"
    ></canvas>

    <p
      id="energy-ring-status"
      class="pointer-events-none absolute top-3 left-3 max-w-[calc(100%-1.5rem)] rounded-lg border border-white/15 bg-black/65 px-3 py-1.5 text-xs text-white/80 backdrop-blur-md"
      role="status"
    >
      Loading WebAssembly…
    </p>

    <div
      class="absolute inset-x-3 bottom-3 mx-auto w-auto max-w-2xl rounded-2xl border border-white/15 bg-black/75 p-3.5 shadow-2xl backdrop-blur-md sm:inset-x-6 sm:bottom-5 sm:p-4"
    >
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <!-- The demo loop is an in-memory blob; buffer it before play is pressed. -->
        <audio
          id="energy-ring-audio"
          class="h-10 min-w-0 flex-1"
          controls
          loop
          preload="auto"></audio>
        <label
          class="inline-flex shrink-0 cursor-pointer items-center justify-center rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-xs font-medium text-white transition-colors hover:bg-white/20"
        >
          <span>Load audio file</span>
          <input
            id="energy-ring-file"
            class="sr-only"
            type="file"
            accept="audio/*"
          />
        </label>
      </div>

      <dl class="mt-3 grid grid-cols-4 gap-3">
        {
          meters.map((name) => (
            <div>
              <dt class="text-[0.65rem] font-medium tracking-wider text-white/60 uppercase">
                {name}
              </dt>
              <dd class="mt-1 h-1.5 overflow-hidden rounded-full bg-white/15">
                <div
                  id={`energy-ring-${name}`}
                  class="h-full origin-left bg-cyan-300"
                  style="scale: 0 1"
                />
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <dialog id="energy-ring-about-dialog" class="er-about-dialog">
    <div class="mb-3 flex items-center justify-between gap-4">
      <h2 class="text-base font-semibold">About Energy Ring</h2>
      <button
        id="energy-ring-about-close"
        type="button"
        class="rounded-md border border-white/20 px-2.5 py-1 text-xs font-medium text-white/80 hover:bg-white/10 hover:text-white"
      >
        Close
      </button>
    </div>
    <p class="text-sm leading-relaxed text-white/75">
      A Rust crate compiled to WebAssembly reads the spectrum of whatever this
      page plays and draws a tilted ring with WebGL2. Louder bands lift the ring
      out of its plane. Press play on the built-in loop, or load a track of your
      own.
    </p>
  </dialog>
</LabLayout>

<script>
  import '@/scripts/energy-ring'

  const aboutBtn = document.getElementById('energy-ring-about-btn')
  const aboutDialog = document.getElementById(
    'energy-ring-about-dialog',
  ) as HTMLDialogElement | null
  const aboutClose = document.getElementById('energy-ring-about-close')

  aboutBtn?.addEventListener('click', () => aboutDialog?.showModal())
  aboutClose?.addEventListener('click', () => aboutDialog?.close())
  aboutDialog?.addEventListener('click', (event) => {
    if (event.target === aboutDialog) aboutDialog.close()
  })
</script>

<style>
  .er-about-dialog {
    margin: auto;
    width: min(calc(100% - 2rem), 30rem);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 0.875rem;
    background: #0b0f14;
    color: #fff;
    padding: 1.25rem;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.65);
  }
  .er-about-dialog::backdrop {
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(4px);
  }
</style>
