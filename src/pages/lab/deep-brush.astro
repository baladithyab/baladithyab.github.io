---
import LabLayout from '@/layouts/LabLayout.astro'

const tools = [
  { value: 'paint', label: 'Paint', key: 'B' },
  { value: 'light', label: 'Light', key: 'L' },
  { value: 'erase', label: 'Erase', key: 'E' },
  { value: 'decal', label: 'Decal', key: 'D' },
]
const modes = [
  { value: '1', label: 'Surface', hint: 'Tilts with the surface' },
  { value: '2', label: 'Wrap', hint: 'Follows its curves' },
  { value: '0', label: 'Flat', hint: 'Faces the screen' },
]
const maskCues = [
  { name: 'maskDepth', label: 'Depth', value: 50 },
  { name: 'maskNormal', label: 'Surface direction', value: 40 },
  { name: 'maskColor', label: 'Color', value: 0 },
]
const views = ['Result', 'Original', 'Depth', 'Normals', 'Shading', 'Albedo']
const swatches = [
  { color: '#f2bf1a', label: 'Yellow' },
  { color: '#ec4855', label: 'Red' },
  { color: '#3785ef', label: 'Blue' },
  { color: '#55c4a0', label: 'Green' },
  { color: '#f5f2eb', label: 'White' },
]
---

<LabLayout
  title="Deep Brush | Rust + WebGPU lab"
  description="Paint on the surfaces in a photo. A local Rust, WebAssembly and WebGPU experiment inspired by Adobe's Project Deep Brush."
  ogTag="Lab"
  ogAccent="#f59e0b"
  appName="Deep Brush"
  appCategory="Rust + WebGPU"
  appSubtitle="Images stay in this browser"
  noindex
>
  <button
    slot="topbar-actions"
    id="deep-brush-about-btn"
    type="button"
    class="text-muted-foreground hover:bg-accent hover:text-foreground rounded-md border px-2.5 py-1 text-xs font-medium transition-colors"
  >
    About
  </button>

  <section class="db-lab">
    <form id="deep-brush-controls" autocomplete="off">
      <div class="db-document-bar">
        <div class="db-actions">
          <button id="deep-brush-open" type="button" class="db-button"
            >Open image</button
          >
          <input
            id="deep-brush-file"
            type="file"
            accept="image/*"
            aria-label="Open image"
            hidden
          />
          <button
            id="deep-brush-sample"
            type="button"
            class="db-button db-quiet">Sample scene</button
          >
          <span id="deep-brush-image-info" class="db-file-info"
            >Opening sample...</span
          >
        </div>
        <div class="db-actions">
          <button
            id="deep-brush-undo"
            type="button"
            class="db-button"
            title="Undo (Ctrl/Cmd+Z)"
            disabled>Undo</button
          >
          <button
            id="deep-brush-model"
            type="button"
            class="db-button db-primary"
            disabled>Analyze depth (99 MB)</button
          >
          <button
            id="deep-brush-export"
            type="button"
            class="db-button"
            disabled>Save PNG</button
          >
        </div>
      </div>

      <div class="db-workspace">
        <div class="db-canvas-panel">
          <div class="db-canvas-topline">
            <div class="db-topline-left">
              <span id="deep-brush-depth-state" class="db-badge"
                >Depth not analyzed</span
              >
              <span id="deep-brush-active-tool" class="db-meta"
                >Paint / Surface</span
              >
            </div>
            <div class="db-feedback">
              <p id="deep-brush-status" role="status" aria-live="polite">
                Starting WebGPU...
              </p>
              <progress
                id="deep-brush-progress"
                max="1"
                value="0"
                aria-label="Depth model download"
                hidden></progress>
              <p id="deep-brush-model-note" class="db-small">
                Downloads a 99 MB model once. Runs locally.
              </p>
            </div>
          </div>

          <div class="db-mat" id="deep-brush-drop-zone">
            <div id="deep-brush-stage" class="db-stage">
              <canvas
                id="deep-brush-canvas"
                role="img"
                aria-label="Photo editor. Drag to paint on the selected surface."
                tabindex="0"
                aria-describedby="deep-brush-hint"></canvas>
              <div
                id="deep-brush-cursor"
                class="db-cursor"
                hidden
                aria-hidden="true"
              >
              </div>
            </div>
            <div id="deep-brush-depth-prompt" class="db-canvas-prompt">
              Analyze depth to start painting on surfaces. Flat mode works
              without it.
            </div>
          </div>

          <div class="db-canvas-bottombar">
            <fieldset class="db-views">
              <legend class="sr-only">Inspect image layers</legend>
              {
                views.map((view, i) => (
                  <label class="db-view">
                    <input
                      type="radio"
                      name="view"
                      value={i}
                      checked={i === 0}
                      data-requires-depth={i > 1 || undefined}
                    />
                    <span>{view}</span>
                  </label>
                ))
              }
            </fieldset>
            <div class="db-bottom-meta">
              <p id="deep-brush-hint" class="db-hint">
                Start on the surface you want to paint. Each stroke stays on
                that surface.
              </p>
              <p class="db-shortcuts">
                <kbd>B</kbd> paint <kbd>L</kbd> light <kbd>E</kbd> erase <kbd
                  >D</kbd
                > decal <span><kbd>[</kbd> <kbd>]</kbd> radius</span>
              </p>
            </div>
          </div>
        </div>

        <aside class="db-inspector" aria-label="Editing tools">
          <fieldset class="db-group">
            <legend>Tool</legend>
            <div class="db-tools">
              {
                tools.map((tool, i) => (
                  <label class="db-tool" title={`${tool.label} (${tool.key})`}>
                    <input
                      type="radio"
                      name="tool"
                      value={tool.value}
                      checked={i === 0}
                    />
                    <span>
                      {tool.label}
                      <kbd>{tool.key}</kbd>
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="db-group">
            <legend>Projection</legend>
            <div class="db-modes">
              {
                modes.map((mode, i) => (
                  <label class="db-mode">
                    <input
                      type="radio"
                      name="mode"
                      value={mode.value}
                      checked={i === 0}
                    />
                    <span>
                      <>
                        <strong>{mode.label}</strong>
                        <small>{mode.hint}</small>
                      </>
                    </span>
                  </label>
                ))
              }
            </div>
            <p id="deep-brush-mode-hint" class="db-small">
              Paint lands on the surface under each dab.
            </p>
          </fieldset>

          <fieldset class="db-group">
            <legend>Smart mask</legend>
            <label class="db-check"
              ><input name="smartMask" type="checkbox" checked /> Keep paint on the
              surface you start on</label
            >
            {
              maskCues.map((cue) => (
                <>
                  <label class="db-slider-label" for={`db-${cue.name}`}>
                    {cue.label}
                    <output for={`db-${cue.name}`} data-value={cue.name}>
                      {cue.value === 0 ? 'Off' : cue.value}
                    </output>
                  </label>
                  <input
                    id={`db-${cue.name}`}
                    name={cue.name}
                    type="range"
                    min="0"
                    max="100"
                    value={cue.value}
                  />
                </>
              ))
            }
            <label class="db-check"
              ><input name="maskFollow" type="checkbox" /> Re-sample along the stroke</label
            >
            <p class="db-small">
              Higher is stricter. Start a stroke on the wall and it skips
              whatever stands in front of it. Re-sampling lets one stroke move
              across surfaces that change gradually, and onto anything it
              crosses.
            </p>
          </fieldset>

          <fieldset class="db-group" data-tool-panel="paint light decal">
            <legend>Color</legend>
            <div class="db-color-row">
              <input
                name="color"
                type="color"
                value="#f2bf1a"
                aria-label="Paint color"
              />
              <div class="db-swatches">
                {
                  swatches.map(({ color, label }) => (
                    <button
                      type="button"
                      class="db-swatch"
                      data-color={color}
                      style={`--swatch: ${color}`}
                      aria-label={`Use ${label.toLowerCase()} paint`}
                      aria-pressed={color === '#f2bf1a'}
                      title={label}
                    >
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        aria-hidden="true"
                      >
                        <path d="m6 12 4 4 8-8" />
                      </svg>
                    </button>
                  ))
                }
              </div>
            </div>
          </fieldset>

          <fieldset class="db-group" data-tool-panel="paint light erase">
            <legend>Brush</legend>
            <label class="db-slider-label" for="db-size"
              >Radius <output for="db-size" data-value="size">24 px</output
              ></label
            >
            <input
              id="db-size"
              name="size"
              type="range"
              min="2"
              max="200"
              value="24"
            />
            <label class="db-slider-label" for="db-hardness"
              >Hardness <output for="db-hardness" data-value="hardness"
                >60%</output
              ></label
            >
            <input
              id="db-hardness"
              name="hardness"
              type="range"
              min="0"
              max="1"
              step="0.01"
              value="0.6"
            />
          </fieldset>

          <fieldset class="db-group">
            <legend class="sr-only">Opacity</legend>
            <label class="db-slider-label" for="db-opacity"
              >Opacity <output for="db-opacity" data-value="opacity">90%</output
              ></label
            >
            <input
              id="db-opacity"
              name="opacity"
              type="range"
              min="0.05"
              max="1"
              step="0.01"
              value="0.9"
            />
          </fieldset>

          <fieldset class="db-group" data-tool-panel="erase" hidden>
            <legend>Erase from</legend>
            <div class="db-inline-choice">
              <label
                ><input type="radio" name="eraseLayer" value="paint" checked /> Paint</label
              >
              <label
                ><input type="radio" name="eraseLayer" value="light" /> Light</label
              >
            </div>
          </fieldset>

          <fieldset class="db-group" data-tool-panel="decal" hidden>
            <legend>Artwork</legend>
            <label class="db-small" for="db-text">Text</label>
            <div class="db-text-row">
              <input
                id="db-text"
                name="text"
                type="text"
                value="MAX 2026"
                maxlength="40"
              />
              <button id="deep-brush-text" type="button" class="db-button"
                >Use text</button
              >
            </div>
            <label class="db-file-label" for="deep-brush-decal-file"
              >Or a logo or transparent image</label
            >
            <input id="deep-brush-decal-file" type="file" accept="image/*" />
            <label class="db-slider-label" for="db-decal-size"
              >Width <output for="db-decal-size" data-value="decalSize"
                >30%</output
              ></label
            >
            <input
              id="db-decal-size"
              name="decalSize"
              type="range"
              min="0.02"
              max="0.6"
              step="0.005"
              value="0.15"
            />
            <label class="db-slider-label" for="db-decal-angle"
              >Rotation <output for="db-decal-angle" data-value="decalAngle"
                >0°</output
              ></label
            >
            <input
              id="db-decal-angle"
              name="decalAngle"
              type="range"
              min="-180"
              max="180"
              value="0"
            />
            <div class="db-actions">
              <button
                id="deep-brush-apply"
                type="button"
                class="db-button db-primary"
                disabled>Apply decal</button
              >
              <button
                id="deep-brush-cancel"
                type="button"
                class="db-button"
                disabled>Cancel</button
              >
            </div>
            <p class="db-small">
              Make artwork, drag to place, Enter to apply. Escape cancels.
            </p>
          </fieldset>

          <fieldset class="db-group" data-tool-panel="light" hidden>
            <legend>Light direction</legend>
            <label class="db-slider-label" for="db-azimuth"
              >Horizontal <output for="db-azimuth" data-value="azimuth"
                >-35°</output
              ></label
            >
            <input
              id="db-azimuth"
              name="azimuth"
              type="range"
              min="-90"
              max="90"
              value="-35"
            />
            <label class="db-slider-label" for="db-elevation"
              >Vertical <output for="db-elevation" data-value="elevation"
                >25°</output
              ></label
            >
            <input
              id="db-elevation"
              name="elevation"
              type="range"
              min="-80"
              max="80"
              value="25"
            />
            <label class="db-slider-label" for="db-intensity"
              >Added light <output for="db-intensity" data-value="intensity"
                >1.5×</output
              ></label
            >
            <input
              id="db-intensity"
              name="intensity"
              type="range"
              min="0"
              max="4"
              step="0.05"
              value="1.5"
            />
            <label class="db-slider-label" for="db-ambient"
              >Original light <output for="db-ambient" data-value="ambient"
                >100%</output
              ></label
            >
            <input
              id="db-ambient"
              name="ambient"
              type="range"
              min="0.1"
              max="1.5"
              step="0.01"
              value="1"
            />
            <label class="db-check"
              ><input name="geometry" type="checkbox" checked /> Follow surface normals</label
            >
          </fieldset>

          <details class="db-advanced">
            <summary>Layer options</summary>
            <div class="db-actions">
              <button id="deep-brush-clear" type="button" class="db-button"
                >Clear paint</button
              >
              <button
                id="deep-brush-clear-light"
                type="button"
                class="db-button">Clear light</button
              >
            </div>
          </details>
        </aside>
      </div>
    </form>
  </section>

  <dialog id="deep-brush-about-dialog" class="db-about-dialog">
    <div class="db-about-header">
      <h2>How Deep Brush works</h2>
      <button
        id="deep-brush-about-close"
        type="button"
        class="db-button db-button-sm">Close</button
      >
    </div>
    <p>
      Inspired by Adobe's <a
        href="https://labs.adobe.com/sneaks/deep-brush"
        rel="noopener"
        target="_blank">Project Deep Brush</a
      >. Depth Anything V2 Small runs in Rust and WGSL to estimate depth from
      your image. Surface normals guide paint and decals; a smart mask keeps
      each stroke on surfaces like the one it started on, so paint goes behind
      whatever stands in front. A heuristic shading split preserves texture and
      shadows. Depth is estimated, not measured: hair, glass and very thin edges
      can come out soft.
    </p>
    <p>
      Drop or paste any browser-supported image. Large images are resized to a
      2048 px edge. Nothing is uploaded. The depth model downloads from Hugging
      Face and stays cached in this browser.
    </p>
  </dialog>
</LabLayout>

<script>
  import '@/scripts/deep-brush'

  const aboutBtn = document.getElementById('deep-brush-about-btn')
  const aboutDialog = document.getElementById(
    'deep-brush-about-dialog',
  ) as HTMLDialogElement | null
  const aboutClose = document.getElementById('deep-brush-about-close')

  aboutBtn?.addEventListener('click', () => aboutDialog?.showModal())
  aboutClose?.addEventListener('click', () => aboutDialog?.close())
  aboutDialog?.addEventListener('click', (event) => {
    if (event.target === aboutDialog) aboutDialog.close()
  })
</script>

<style>
  .db-lab {
    display: flex;
    flex: 1;
    min-height: 0;
    width: 100%;
    flex-direction: column;
    overflow: hidden;
  }
  #deep-brush-controls {
    display: flex;
    flex: 1;
    min-height: 0;
    flex-direction: column;
    overflow: hidden;
    background: hsl(var(--card));
  }
  .db-document-bar,
  .db-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: calc(var(--spacing) * 2);
  }
  .db-document-bar {
    flex-shrink: 0;
    padding: calc(var(--spacing) * 2) calc(var(--spacing) * 3.5);
    justify-content: space-between;
    border-bottom: 1px solid hsl(var(--border));
    background: hsl(var(--muted) / 0.45);
  }
  .db-file-info {
    font-size: 0.75rem;
    color: hsl(var(--muted-foreground));
    overflow-wrap: anywhere;
  }
  .db-button {
    min-height: calc(var(--spacing) * 8.5);
    padding: calc(var(--spacing) * 1.5) calc(var(--spacing) * 2.75);
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    background: hsl(var(--background));
    font-size: 0.78rem;
    font-weight: 550;
    cursor: pointer;
  }
  .db-button-sm {
    min-height: calc(var(--spacing) * 7.5);
    padding: calc(var(--spacing) * 1) calc(var(--spacing) * 2.5);
  }
  .db-button:hover:not(:disabled) {
    background: hsl(var(--accent));
  }
  .db-button:active:not(:disabled) {
    transform: translateY(1px);
  }
  .db-primary {
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
    border-color: transparent;
  }
  .db-primary:hover:not(:disabled) {
    background: hsl(var(--primary) / 0.88);
  }
  .db-quiet {
    background: transparent;
    border-color: transparent;
  }
  .db-button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .db-button[aria-busy='true'] {
    opacity: 1;
    cursor: progress;
  }
  .db-workspace {
    display: grid;
    flex: 1;
    min-height: 0;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(17rem, 58%) minmax(0, 1fr);
    overflow: hidden;
  }
  .db-canvas-panel {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background: hsl(var(--muted) / 0.25);
  }
  .db-canvas-topline {
    flex-shrink: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: calc(var(--spacing) * 1.5) calc(var(--spacing) * 2);
    padding: calc(var(--spacing) * 1.5) calc(var(--spacing) * 3);
    border-bottom: 1px solid hsl(var(--border));
    background: hsl(var(--background) / 0.85);
    font-size: 0.75rem;
  }
  .db-topline-left {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 2);
  }
  .db-badge {
    padding: calc(var(--spacing) * 0.75) calc(var(--spacing) * 2);
    border-radius: var(--radius);
    background: hsl(var(--muted));
    font-weight: 550;
  }
  .db-meta {
    color: hsl(var(--muted-foreground));
  }
  .db-feedback {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(var(--spacing) * 2);
    font-size: 0.74rem;
    min-width: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
  }
  .db-feedback p[data-tone='error'] {
    color: hsl(var(--destructive));
    font-weight: 600;
  }
  @media (max-width: 63.99rem) {
    .db-document-bar {
      padding: calc(var(--spacing) * 1.5) calc(var(--spacing) * 2.5);
      gap: calc(var(--spacing) * 1.5);
    }
    .db-file-info,
    .db-feedback .db-small,
    .db-bottom-meta {
      display: none;
    }
    #deep-brush-status {
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .db-canvas-bottombar {
      padding: calc(var(--spacing) * 1.25) calc(var(--spacing) * 2.5);
    }
    .db-views {
      flex-wrap: nowrap;
      overflow-x: auto;
      max-width: 100%;
    }
  }
  progress {
    width: 8rem;
    height: calc(var(--spacing) * 1.5);
    accent-color: hsl(var(--primary));
  }
  .db-mat {
    flex: 1;
    min-height: 0;
    container-type: size;
    display: grid;
    place-items: center;
    padding: calc(var(--spacing) * 3);
    position: relative;
    overflow: hidden;
  }
  .db-mat[data-dragging='true'] {
    outline: 2px solid hsl(var(--ring));
    outline-offset: -4px;
  }
  .db-stage {
    position: relative;
    width: min(100cqw, calc(100cqh * var(--image-aspect, 1.5)));
    max-height: 100%;
    aspect-ratio: var(--image-aspect, 1.5);
    overflow: hidden;
    border-radius: calc(var(--radius) * 0.5);
    background: hsl(var(--background));
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.14);
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
    cursor: crosshair;
  }
  canvas[data-blocked='true'] {
    cursor: not-allowed;
  }
  .db-cursor {
    position: absolute;
    pointer-events: none;
    border: 1px solid hsl(var(--background));
    outline: 1px solid hsl(var(--foreground));
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }
  .db-canvas-prompt {
    position: absolute;
    bottom: calc(var(--spacing) * 3);
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.75rem;
    text-align: center;
    padding: calc(var(--spacing) * 1.75) calc(var(--spacing) * 3);
    max-width: min(92%, 44ch);
    border-radius: var(--radius);
    border: 1px solid hsl(var(--border));
    background: hsl(var(--background) / 0.9);
    backdrop-filter: blur(8px);
    color: hsl(var(--muted-foreground));
  }
  .db-canvas-bottombar {
    flex-shrink: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: calc(var(--spacing) * 2) calc(var(--spacing) * 4);
    padding: calc(var(--spacing) * 2) calc(var(--spacing) * 3.5);
    border-top: 1px solid hsl(var(--border));
    background: hsl(var(--background) / 0.9);
  }
  .db-views {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing);
  }
  .db-bottom-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(var(--spacing) * 1.5) calc(var(--spacing) * 3);
  }
  .db-view,
  .db-tool,
  .db-mode {
    position: relative;
    cursor: pointer;
  }
  .db-view input,
  .db-tool input,
  .db-mode input {
    position: absolute;
    inset: 0;
    opacity: 0;
    width: 100%;
    height: 100%;
    cursor: pointer;
  }
  .db-view span {
    display: block;
    border-radius: var(--radius);
    padding: calc(var(--spacing) * 1.25) calc(var(--spacing) * 2);
    font-size: 0.73rem;
  }
  .db-view input:checked + span {
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
  }
  .db-view input:hover + span {
    box-shadow: inset 0 0 0 1px hsl(var(--border));
  }
