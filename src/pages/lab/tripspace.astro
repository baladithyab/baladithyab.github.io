---
import LabLayout from '@/layouts/LabLayout.astro'
import Tripspace from '@/components/tripspace/Tripspace'
---

<LabLayout
  title="Tripspace | Group trip planning lab"
  description="Plan a trip with friends from a loose idea to booked flights: who is in, when, where, each person's travel, shared and solo plans, and live prices."
  ogTag="Lab"
  appName="Tripspace"
  appCategory="Group trip lab"
  appSubtitle="Browser-local · live Skiplagged checks"
  noindex
>
  <Tripspace client:only="react">
    <div slot="fallback" class="flex h-full items-center justify-center p-6">
      <p class="text-muted-foreground text-sm">Opening Tripspace.</p>
    </div>
  </Tripspace>
  <noscript>
    <p class="p-6 text-sm">Tripspace needs JavaScript.</p>
  </noscript>
</LabLayout>
