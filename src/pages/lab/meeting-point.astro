---
import LabLayout from '@/layouts/LabLayout.astro'
import MeetingPoint from '@/components/MeetingPoint'
---

<LabLayout
  title="Meeting point | Maps lab"
  description="Find a fair place to meet. Search addresses and landmarks, choose a city, watch its road search unfold, and compare ranked meeting points."
  ogTag="Lab"
  appName="Meeting Point"
  appCategory="Maps lab"
  appSubtitle="Walking-network convergence"
  noindex
>
  <MeetingPoint client:load />
  <noscript>
    <p class="p-6 text-sm">
      This experiment needs JavaScript to search the walking network and animate
      the map.
    </p>
  </noscript>
</LabLayout>
