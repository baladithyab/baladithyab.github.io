---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { Badge } from '@/components/ui/badge'
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from '@/components/ui/card'
import { labs } from '@/lib/labs'
---

<BaseLayout
  title="Labs | codeseys.io"
  description="Interactive full-viewport webapps built on Cloudflare Workers, Rust/WebAssembly, WebGPU, WebGL2, and spatial data."
  ogTag="Labs"
  ogAccent="#10b981"
>
  <section class="container mx-auto max-w-5xl px-6 py-14">
    <header class="mb-10 max-w-2xl">
      <p
        class="text-muted-foreground mb-2 text-xs font-medium tracking-widest uppercase"
      >
        codeseys.io / Labs
      </p>
      <h1 class="mb-3 text-4xl font-bold tracking-tight sm:text-5xl">Labs</h1>
      <p class="text-muted-foreground text-base leading-relaxed sm:text-lg">
        Full-viewport interactive webapps exploring spatial search, real-estate
        due diligence, group trip coordination, and browser-local Rust/Wasm
        graphics.
      </p>
    </header>

    <div class="grid gap-6 sm:grid-cols-2">
      {
        labs.map((lab) => (
          <a
            href={lab.href}
            class="group focus-visible:outline-ring block rounded-xl focus-visible:outline-2 focus-visible:outline-offset-2"
          >
            <Card className="hover-card bg-card/50 flex h-full flex-col justify-between">
              <CardHeader className="pb-3">
                <div class="mb-2 flex items-center justify-between gap-2">
                  <Badge variant="outline" className="text-[0.7rem]">
                    {lab.category}
                  </Badge>
                  <span class="text-muted-foreground group-hover:text-foreground text-xs font-medium transition-colors">
                    Launch app ↗
                  </span>
                </div>
                <CardTitle className="text-xl">{lab.title}</CardTitle>
                <CardDescription className="pt-1.5 text-sm leading-relaxed">
                  {lab.summary}
                </CardDescription>
              </CardHeader>
              <CardContent className="pt-0">
                <div class="flex flex-wrap gap-1.5">
                  {lab.tags.map((tag) => (
                    <Badge
                      variant="secondary"
                      className="text-[0.7rem] font-normal"
                    >
                      {tag}
                    </Badge>
                  ))}
                </div>
              </CardContent>
            </Card>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
