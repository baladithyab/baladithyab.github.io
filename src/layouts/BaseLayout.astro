---
import HeadSEO from '@/components/HeadSEO.astro'
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
import SiteIntro from '@/components/SiteIntro.astro'

interface Props {
  title?: string | undefined
  description?: string | undefined
  ogImage?: URL | undefined
  ogTag?: string | undefined
  ogAccent?: string | undefined
}

const { title, description, ogImage, ogTag, ogAccent } = Astro.props
---

<html lang="en" class="scroll-smooth">
  <head>
    <HeadSEO
      title={title}
      description={description}
      ogImage={ogImage}
      ogTag={ogTag}
      ogAccent={ogAccent}
    />
    <!--
      Theme initialization script - runs synchronously before page renders
      to prevent any flash of wrong theme
    -->
    <script is:inline>
      ;(function () {
        // Get saved theme or detect system preference
        var theme = localStorage.getItem('theme')
        var prefersDark = window.matchMedia(
          '(prefers-color-scheme: dark)',
        ).matches
        var isDark = theme === 'dark' || (!theme && prefersDark)

        // Apply immediately to prevent flash
        if (isDark) {
          document.documentElement.classList.add('dark')
        }

        // Handle page transitions (Astro View Transitions)
        document.addEventListener('astro:after-swap', function () {
          var savedTheme = localStorage.getItem('theme')
          var systemDark = window.matchMedia(
            '(prefers-color-scheme: dark)',
          ).matches
          if (savedTheme === 'dark' || (!savedTheme && systemDark)) {
            document.documentElement.classList.add('dark')
          } else {
            document.documentElement.classList.remove('dark')
          }
        })
      })()
    </script>
  </head>
  <body class="bg-background min-h-screen font-sans antialiased">
    <SiteIntro />
    <div class="site-content">
      <!-- Skip to main content link for accessibility -->
      <a
        href="#main-content"
        class="focus:bg-primary focus:text-primary-foreground sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:px-4 focus:py-2"
      >
        Skip to main content
      </a>
      <div class="relative flex min-h-screen flex-col">
        <Header />
        <main id="main-content" class="flex-auto" role="main">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
  </body>
</html>
